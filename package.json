{
  "name": "board-game",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "bun run --cwd apps/web dev",
    "dev:server": "bun --watch apps/server/src/index.ts",
    "build": "bun run --cwd apps/web build",
    "test": "bun test packages/engine",
    "typecheck": "bun run --cwd packages/engine typecheck && bun run --cwd apps/server typecheck && bun run --cwd apps/web typecheck",
    "build:demo": "bun run --cwd apps/web build:demo"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5.6.3"
  }
}
